# Local/Docker canonical origin, without a trailing slash.
# On Vercel this is optional: system URLs are used automatically.
# Set a custom domain override in Vercel's Production environment only.
NEXT_PUBLIC_SITE_URL=https://tarotwarriorpath.com

# On Vercel this is optional: VERCEL_ENV selects the indexing policy.
# Preview/custom Vercel environments always stay non-indexable.
# Outside Vercel, only "production" is indexable.
DEPLOYMENT_ENV=production

# Required for POST /api/telegram. Set these as server secrets in Vercel.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Reserved for the planned Cloudflare Turnstile integration.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
